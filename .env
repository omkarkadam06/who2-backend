# ============ REQUIRED ============
MONGO_URI=mongodb+srv://who2_admin:who2Password123@clusterom.eot9bec.mongodb.net/who2_db?appName=ClusterOM
JWT_SECRET=super_secret_who2_key_2026
PORT=3000
APP_TZ=Asia/Kolkata

# ============ OTP MODE ============
# true  = the code is shown on the app screen (testing, no SMS/WhatsApp/email needed)
# false = real delivery only. Set this to false only AFTER at least one provider below works.
ALLOW_DEV_OTP=true
# NODE_ENV=production

# ============ OPTIONAL: WhatsApp OTP (Meta WhatsApp Business Cloud API) ============
# WA_PHONE_NUMBER_ID=
# WA_TOKEN=
# WA_TEMPLATE=who2_otp
# WA_LANG=en

# ============ OPTIONAL: SMS OTP (Twilio) ============
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# ============ OPTIONAL: Email OTP (any SMTP service) ============
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="WHO2 <no-reply@yourdomain.com>"

# ============ OPTIONAL: Push notifications (Firebase service account JSON, all on ONE line) ============
# FIREBASE_SERVICE_ACCOUNT=

# ============ OPTIONAL: TURN server so calls work on mobile data ============
# TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=